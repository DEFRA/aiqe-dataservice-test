# Copy this file to .env (which is git-ignored) and fill in your own values.
# wdio.local.conf.js loads .env automatically.

# UK-AIR API token - from POST /api/login_check ("Login Check") at
# https://uk-air-api.staging.rcdo.co.uk/api/docs. Paste the token only, without
# quotes or the word "Bearer". It expires after 5 days, so replace it when the
# tests start getting 401 errors from the UK-AIR API
UK_AIR_API_TOKEN=

# API key for the CDP ephemeral-protected gateway (aqie-back-end, aqie-historicaldata-backend)
CDP_API_KEY=
